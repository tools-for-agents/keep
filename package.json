  "bin": {
    "keep": "src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mcp": "node mcp/mcp-server.js",
    "test": "node --test"
  },
  "license": "MIT",
  "mcpName": "io.github.tools-for-agents/keep",
  "files": [
    "src",
    "mcp",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tools-for-agents/keep.git"
  },
  "homepage": "https://tools-for-agents.github.io",
  "keywords": ["mcp", "mcp-server", "ai-agents", "agent-tools", "claude", "llm", "zero-dependency", "secrets", "redaction", "keep"],
  "publishConfig": {
    "access": "public"
  }
}
